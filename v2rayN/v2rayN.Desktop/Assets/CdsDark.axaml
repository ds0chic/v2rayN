    <BoxShadows x:Key="ForkShadowSm">0 1 2 0 #4D000000</BoxShadows>
    <BoxShadows x:Key="ForkShadowFocus">0 0 0 1 #E08264, 0 0 0 4 #40E08264</BoxShadows>
    <BoxShadows x:Key="ForkShadowFocusPill">0 0 0 1 #E08264, 0 0 0 4 #40E08264, 0 4 16 0 #66000000</BoxShadows>
    <BoxShadows x:Key="ForkShadowPanel">inset 0 0 0 1 #1AFFFFFF, 0 2 8 0 #66000000</BoxShadows>
    <BoxShadows x:Key="ForkShadowPopover">inset 0 0 0 1 #1AFFFFFF, 0 8 24 0 #99000000</BoxShadows>
    <BoxShadows x:Key="ForkShadowComposer">inset 0 0 0 1 #1AFFFFFF, 0 4 16 0 #66000000</BoxShadows>
            <SolidColorBrush x:Key="SemiColorPrimaryDisabled" Color="#80E08264" />
