<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- fork: dark CDS token set; shared by the base variant and the Semi variants built on it -->
    <SolidColorBrush x:Key="SemiColorBackground0" Color="#0B0B0B" />
    <SolidColorBrush x:Key="SemiColorBackground1" Color="#151515" />
    <SolidColorBrush x:Key="SemiColorBackground2" Color="#1A1A19" />
    <SolidColorBrush x:Key="SemiColorBackground3" Color="#20201F" />
    <SolidColorBrush x:Key="SemiColorBackground4" Color="#2C2C2A" />
    <SolidColorBrush x:Key="SemiColorFill0" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="SemiColorFill1" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="SemiColorFill2" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="SemiColorBorder" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="SemiColorText0" Color="#F5F5F5" />
    <SolidColorBrush x:Key="SemiColorText1" Color="#A3A3A3" />
    <SolidColorBrush x:Key="SemiColorText2" Color="#666666" />
    <SolidColorBrush x:Key="SemiColorText3" Color="#4D4D4D" />
    <SolidColorBrush x:Key="SemiColorPrimary" Color="#D97757" />
    <SolidColorBrush x:Key="SemiColorPrimaryPointerover" Color="#E08264" />
    <SolidColorBrush x:Key="SemiColorPrimaryActive" Color="#CC5A36" />
    <SolidColorBrush x:Key="SemiColorPrimaryLight" Color="#26D97757" />
    <SolidColorBrush x:Key="SemiColorPrimaryLightPointerover" Color="#33D97757" />
    <SolidColorBrush x:Key="SemiColorPrimaryLightActive" Color="#40D97757" />
    <SolidColorBrush x:Key="SemiColorFocusBorder" Color="#D97757" />
    <SolidColorBrush x:Key="SemiColorLink" Color="#D97757" />
    <SolidColorBrush x:Key="SemiColorLinkHover" Color="#E08264" />
    <SolidColorBrush x:Key="SemiColorLinkActive" Color="#CC5A36" />
    <SolidColorBrush x:Key="ForkPopupRing" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="ForkTrack" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="ForkThumb" Color="#2C2C2A" />
    <SolidColorBrush x:Key="ForkClayTag" Color="#D97757" />
    <BoxShadows x:Key="ForkShadowSm">0 1 2 0 #66000000, 0 2 8 0 #66000000</BoxShadows>
    <BoxShadows x:Key="ForkShadowFocus">inset 0 0 0 1 #151515, 0 0 0 1.5 #D97757, 0 0 8 2 #59D97757</BoxShadows>
    <BoxShadows x:Key="ForkShadowFocusPill">inset 0 0 0 1 #151515, 0 0 0 1.5 #D97757, 0 0 8 2 #59D97757, 0 4 24 0 #A6000000</BoxShadows>
    <BoxShadows x:Key="ForkShadowPanel">inset 0 0 0 1 #1AFFFFFF, 0 1 2 0 #66000000, 0 2 8 0 #66000000</BoxShadows>
    <BoxShadows x:Key="ForkShadowPopover">inset 0 0 0 1 #1AFFFFFF, 0 8 28 0 #A6000000, 0 2 8 0 #73000000</BoxShadows>
    <BoxShadows x:Key="ForkShadowComposer">inset 0 0 0 1 #17FFFFFF, 0 4 20 0 #66000000</BoxShadows>
    <BoxShadows x:Key="ForkShadowComposerHover">inset 0 0 0 1 #2EFFFFFF, 0 4 24 0 #8C000000</BoxShadows>
    <BoxShadows x:Key="ForkShadowLg">0 4 8 0 #80000000, 0 16 36 -2 #66000000</BoxShadows>
    <SolidColorBrush x:Key="ForkClayLight" Color="#26D97757" />
    <SolidColorBrush x:Key="ForkClay" Color="#D97757" />
            <SolidColorBrush x:Key="SemiColorPrimaryDisabled" Color="#80D97757" />
