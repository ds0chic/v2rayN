<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- fork: dark CDS token set; shared by the base variant and the Semi variants built on it -->
    <SolidColorBrush x:Key="SemiColorBackground0" Color="#0B0B0A" />
