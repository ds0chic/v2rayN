    <SolidColorBrush x:Key="SemiColorBackground2" Color="#1A1A19" />
    <SolidColorBrush x:Key="SemiColorBackground3" Color="#20201E" />
    <SolidColorBrush x:Key="SemiColorBackground4" Color="#272725" />
