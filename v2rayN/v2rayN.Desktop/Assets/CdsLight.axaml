<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- fork: light CDS token set; shared by the base variant and the Semi variants built on it -->
    <SolidColorBrush x:Key="SemiColorBackground0" Color="#F9F9F7" />
    <SolidColorBrush x:Key="SemiColorBackground1" Color="#FCFCFB" />
    <SolidColorBrush x:Key="SemiColorBackground2" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SemiColorBackground3" Color="#F3F3F0" />
    <SolidColorBrush x:Key="SemiColorBackground4" Color="#EDECE8" />
