    <SolidColorBrush x:Key="SemiColorLinkActive" Color="#A04427" />
    <SolidColorBrush x:Key="ForkPopupRing" Color="#00000000" />
    <SolidColorBrush x:Key="ForkTrack" Color="#0F000000" />
    <SolidColorBrush x:Key="ForkThumb" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ForkClayTag" Color="#D97757" />
    <BoxShadows x:Key="ForkShadowSm">0 1 2 0 #0D000000, 0 2 8 0 #14000000</BoxShadows>
    <BoxShadows x:Key="ForkShadowFocus">inset 0 0 0 1 #FCFCFB, 0 0 0 1.5 #D97757, 0 0 6 1 #40D97757</BoxShadows>
    <BoxShadows x:Key="ForkShadowFocusPill">inset 0 0 0 1 #FCFCFB, 0 0 0 1.5 #D97757, 0 0 6 1 #40D97757, 0 4 24 0 #14000000</BoxShadows>
    <BoxShadows x:Key="ForkShadowPanel">0 0 0 1 #1A141414, 0 1 2 0 #0D000000, 0 2 8 0 #14000000</BoxShadows>
    <BoxShadows x:Key="ForkShadowPopover">0 0 0 1 #1A141414, 0 8 24 0 #1F000000, 0 2 6 0 #14000000</BoxShadows>
    <BoxShadows x:Key="ForkShadowComposer">inset 0 0 0 1 #1A141414, 0 4 20 0 #09000000</BoxShadows>
    <BoxShadows x:Key="ForkShadowComposerHover">inset 0 0 0 1 #33141414, 0 4 24 0 #0F000000</BoxShadows>
    <BoxShadows x:Key="ForkShadowLg">0 4 8 0 #0F000000, 0 12 28 -2 #14000000</BoxShadows>
    <SolidColorBrush x:Key="ForkClayLight" Color="#FBF3EF" />
    <SolidColorBrush x:Key="ForkClay" Color="#D97757" />
            <SolidColorBrush x:Key="SemiColorPrimaryDisabled" Color="#80D97757" />
