    <SolidColorBrush x:Key="SemiColorFill1" Color="#1A141414" />
    <SolidColorBrush x:Key="SemiColorFill2" Color="#33141414" />
    <SolidColorBrush x:Key="SemiColorBorder" Color="#1A141414" />
    <SolidColorBrush x:Key="SemiColorText0" Color="#151515" />
    <SolidColorBrush x:Key="SemiColorText1" Color="#525252" />
    <SolidColorBrush x:Key="SemiColorText2" Color="#8A8A8A" />
    <SolidColorBrush x:Key="SemiColorText3" Color="#B0B0B0" />
