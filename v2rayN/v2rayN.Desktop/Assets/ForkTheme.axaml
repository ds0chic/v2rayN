<Styles xmlns="https://github.com/avaloniaui" xmlns:ae="using:AvaloniaEdit" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Fork design system. Colors come from Semi tokens so the user-selected theme variant keeps working;
        shape, spacing and type scale are defined here. Components are used through classes:
          Border.card, TextBlock.sectionTitle, TextBlock.secondary, Border.divider, Border.chip, Grid.settingRow
    -->

    <Styles.Resources>
        <ResourceDictionary>
        <CornerRadius x:Key="ForkRadius">12</CornerRadius>
        <CornerRadius x:Key="ForkRadiusMd">8</CornerRadius>
        <CornerRadius x:Key="ForkRadiusPill">999</CornerRadius>
        <CornerRadius x:Key="ForkRadiusSm">6</CornerRadius>
        <x:Double x:Key="ForkFontBase">12</x:Double>
        <x:Double x:Key="ForkFontSmall">11</x:Double>
        <x:Double x:Key="ForkFontTitle">16</x:Double>
        <!--
            Motion tokens from open-claude-ui (ClaudeMotionPresets / cds-theme.css). Pick by interaction:
              Snappy (600/30): segmented, tab and press feedback. Bouncy (380/18): switches and badges.
              Gentle (320/28): dialogs, expanders, entering blocks. HeavySnap (1200/80): drag and snap, no overshoot.
            Curves: Swift for hover fades, Enter for blocks and popups, Pulse for breathing dots.
        -->
        <SpringEasing x:Key="CdsSpringSnappy" Mass="1" Stiffness="600" Damping="30" />
        <SpringEasing x:Key="CdsSpringBouncy" Mass="1" Stiffness="380" Damping="18" />
        <SpringEasing x:Key="CdsSpringGentle" Mass="1" Stiffness="320" Damping="28" />
        <SpringEasing x:Key="CdsSpringHeavySnap" Mass="1" Stiffness="1200" Damping="80" />
        <SplineEasing x:Key="CdsEaseSwift" X1="0.16" Y1="1" X2="0.3" Y2="1" />
        <SplineEasing x:Key="CdsEaseEnter" X1="0.22" Y1="1" X2="0.36" Y2="1" />
        <SplineEasing x:Key="CdsEaseExpand" X1="0.19" Y1="1" X2="0.22" Y2="1" />
        <SplineEasing x:Key="CdsEasePulse" X1="0.4" Y1="0" X2="0.2" Y2="1" />
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="ForkActiveRow" Color="#F8EBE3" />
                <SolidColorBrush x:Key="ForkSelectedOutline" Color="#D97757" />
                <SolidColorBrush x:Key="ForkActiveRowHover" Color="#F5E1D5" />
                <SolidColorBrush x:Key="ForkActiveRowSelected" Color="#F2D9C9" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="Dark">
                <SolidColorBrush x:Key="ForkActiveRow" Color="#33271F" />
                <SolidColorBrush x:Key="ForkSelectedOutline" Color="#E08264" />
                <SolidColorBrush x:Key="ForkActiveRowHover" Color="#3B2D24" />
                <SolidColorBrush x:Key="ForkActiveRowSelected" Color="#473328" />
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- Base typography: slightly smaller and calmer than the Semi default. -->
    <Style Selector="Window">
        <Setter Property="FontSize" Value="{StaticResource ForkFontBase}" />
    </Style>

    <!-- The main toolbar draws its own title; the drawn window decorations would paint a second one over it. -->
    <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel">
        <Setter Property="Opacity" Value="0" />
    </Style>

    <!-- The caption fullscreen (expand) button is not wanted; hide it with the other caption buttons intact. -->
    <Style Selector="WindowDrawnDecorations /template/ Button#PART_FullScreenButton">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="WindowDrawnDecorations /template/ Button#PART_PopoverFullScreenButton">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Caption buttons: 46x44 so the hover area fills the 44 px title band and their icon centers sit on the toolbar's center line. -->
    <Style Selector="WindowDrawnDecorations /template/ Button#PART_MinimizeButton, WindowDrawnDecorations /template/ Button#PART_MaximizeButton, WindowDrawnDecorations /template/ Button#PART_CloseButton">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- Surfaces -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BoxShadow" Value="{DynamicResource ForkShadowPanel}" />
        <Setter Property="CornerRadius" Value="{StaticResource ForkRadius}" />
        <Setter Property="Padding" Value="14,2" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style Selector="Border.divider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource SemiColorBorder}" />
        <Setter Property="Opacity" Value="0.7" />
    </Style>

    <Style Selector="Border.chip">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.chip > TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
    </Style>

    <!-- Text roles -->
    <Style Selector="TextBlock.sectionTitle">
        <Setter Property="FontSize" Value="{StaticResource ForkFontSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
        <Setter Property="Margin" Value="4,12,0,6" />
    </Style>

    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="{StaticResource ForkFontTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.secondary">
        <Setter Property="FontSize" Value="{StaticResource ForkFontSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
    </Style>

    <!-- Settings row: label on the left, control on the right, fixed comfortable height. -->
    <Style Selector="Grid.settingRow">
        <Setter Property="MinHeight" Value="38" />
    </Style>
    <Style Selector="Grid.settingRow > TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Data grids: flat, no vertical lines, quiet header. -->
    <Style Selector="DataGrid">
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="RowHeight" Value="28" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource SemiColorBorder}" />
    </Style>
    <!-- The header row sits on its own faint band so it reads apart from the group tabs above it. -->
    <Style Selector="DataGridColumnHeadersPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="DataGridColumnHeader /template/ Rectangle#VerticalSeparator">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- The header hover block is the header's own Background (square); move it onto the rounded HeaderBackground border. -->
    <Style Selector="DataGridColumnHeader /template/ Border#HeaderBackground">
        <Setter Property="CornerRadius" Value="{StaticResource ForkRadiusMd}" />
    </Style>
    <Style Selector="DataGridColumnHeader:pointerover, DataGridColumnHeader:pressed">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="DataGridColumnHeader:pointerover /template/ Border#HeaderBackground, DataGridColumnHeader:pressed /template/ Border#HeaderBackground">
        <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="FontSize" Value="{StaticResource ForkFontSmall}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="AreSeparatorsVisible" Value="False" />
    </Style>
    <!--
        Active (in-use) node: an orange tint. Semi paints a row's background (normal, hover, selected) on the
        BackgroundBorder template part, so the tint has to target that part. A selected row turns blue; on the active row it stays orange (stronger) and gains a clay outline.
    -->
    <Style Selector="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- One line style: row separators match Border.divider; the current-cell outline (a stray vertical line in the focused row) is hidden. -->
    <Style Selector="DataGridRow /template/ Rectangle#PART_BottomGridLine">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="DataGridCell TextBlock">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="DataGridCell /template/ Rectangle#CurrencyVisual">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="DataGridRow /template/ Border#BackgroundBorder">
        <Setter Property="CornerRadius" Value="{StaticResource ForkRadiusMd}" />
        <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="DataGridRow.activeNode /template/ Border#BackgroundBorder">
        <Setter Property="Background" Value="{DynamicResource ForkActiveRow}" />
    </Style>
    <Style Selector="DataGridRow.activeNode:pointerover /template/ Border#BackgroundBorder">
        <Setter Property="Background" Value="{DynamicResource ForkActiveRowHover}" />
    </Style>
    <Style Selector="DataGridRow.activeNode:selected /template/ Border#BackgroundBorder">
        <Setter Property="Background" Value="{DynamicResource ForkActiveRowSelected}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ForkSelectedOutline}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="DataGridRow.activeNode:selected:pointerover /template/ Border#BackgroundBorder">
        <Setter Property="Background" Value="{DynamicResource ForkActiveRowSelected}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ForkSelectedOutline}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!--
        Motion: one easing curve, short durations. Hover/press feedback is a quick color fade and a barely
        perceptible press-in; nothing bounces or slides.
    -->
    <Style Selector="Button">
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Easing="{StaticResource CdsSpringSnappy}" Property="RenderTransform" Duration="0:0:0.3" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button:pressed">
        <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Easing="{StaticResource CdsEaseSwift}" Property="Background" Duration="0:0:0.15" />
                <BrushTransition Easing="{StaticResource CdsEaseSwift}" Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>


    <!--
        User font size (top-right menu). ThemeSettingViewModel sets ForkUserFontSize / ForkUserRowHeight and puts the
        `userFont` class on every window; nothing is added to the application styles at runtime.
    -->
    <Style Selector="Window.userFont Button, Window.userFont TextBox, Window.userFont TextBlock, Window.userFont SelectableTextBlock, Window.userFont Menu, Window.userFont ContextMenu, Window.userFont DataGridRow, Window.userFont ListBoxItem, Window.userFont HeaderedContentControl, Window.userFont ae|TextEditor">
        <Setter Property="TextElement.FontSize" Value="{DynamicResource ForkUserFontSize}" />
    </Style>
    <!-- The tray menu is a popup root, not a child of any Window, so the window class never reaches it. -->
    <Style Selector="MenuItem">
        <Setter Property="FontSize" Value="{DynamicResource ForkUserFontSize}" />
    </Style>
    <Style Selector="Window.userFont DataGrid">
        <Setter Property="RowHeight" Value="{DynamicResource ForkUserRowHeight}" />
    </Style>
    <Style Selector="Window.userFont TextBlock.secondary, Window.userFont TextBlock.sectionTitle, Window.userFont Border.chip > TextBlock, Window.userFont DataGridColumnHeader">
        <Setter Property="TextElement.FontSize" Value="{DynamicResource ForkUserSmallSize}" />
    </Style>
    <Style Selector="Window.userFont TextBlock.title">
        <Setter Property="TextElement.FontSize" Value="{DynamicResource ForkUserFontSize}" />
    </Style>
    <Style Selector="Window.userFont Grid.settingRow">
        <Setter Property="MinHeight" Value="{DynamicResource ForkUserSettingRowHeight}" />
    </Style>
    <Style Selector="Window.userFont Border.card">
        <Setter Property="Padding" Value="{DynamicResource ForkUserCardPadding}" />
        <Setter Property="Margin" Value="{DynamicResource ForkUserCardMargin}" />
    </Style>
    <Style Selector="Window.userFont TextBlock.sectionTitle">
        <Setter Property="Margin" Value="{DynamicResource ForkUserSectionMargin}" />
    </Style>

    <!-- Pages cross-fade briefly instead of snapping, so switching tabs never feels like a cut. -->
    <Style Selector="TabControl">
        <Setter Property="PageTransition">
            <CrossFade Duration="0:0:0.2" />
        </Setter>
    </Style>

    <!-- Controls: a little more compact and rounded than the Semi default. -->
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="{StaticResource ForkRadiusMd}" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="{StaticResource ForkRadiusMd}" />
    </Style>
    <Style Selector="TextBox.pill">
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{DynamicResource SemiColorBackground2}" />
    </Style>
    <Style Selector="TextBox.pill /template/ Border#PART_BorderElement">
        <Setter Property="BoxShadow" Value="{DynamicResource ForkShadowComposer}" />
    </Style>
    <Style Selector="TextBox.pill:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BoxShadow" Value="{DynamicResource ForkShadowComposerHover}" />
    </Style>
    <!-- Same end radius as the switch track beside it in the status bar (Semi ToggleSwitch track is 24 px tall). -->
    <Style Selector="ComboBox.pill">
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="HyperlinkButton">
        <Setter Property="Foreground" Value="{DynamicResource SemiColorLink}" />
    </Style>
    <Style Selector="HyperlinkButton:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource SemiColorLinkHover}" />
    </Style>
    <Style Selector="HyperlinkButton /template/ ContentPresenter">
        <Setter Property="Foreground" Value="{Binding $parent[HyperlinkButton].Foreground}" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="{StaticResource ForkRadiusMd}" />
    </Style>

    <!--
        Corner radii follow two tiers only: surfaces (cards, dialogs, popups) use ForkRadius, controls and
        their inner items (buttons, inputs, list/menu items, tooltips) use ForkRadiusSm.
    -->
    <Style Selector="NumericUpDown">
        <Setter Property="CornerRadius" Value="{StaticResource ForkRadiusSm}" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="CornerRadius" Value="{StaticResource ForkRadiusSm}" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="CornerRadius" Value="{StaticResource ForkRadiusSm}" />
    </Style>
    <Style Selector="TabItem, TreeViewItem, ToggleButton, SplitButton, DropDownButton, AutoCompleteBox, CalendarDatePicker, DatePicker, TimePicker, Calendar, CalendarItem, FlyoutPresenter, ScrollBar /template/ Thumb">
        <Setter Property="CornerRadius" Value="{StaticResource ForkRadiusSm}" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="12,0" />
    </Style>
    <!-- Scrollbars: no arrow buttons, a slim quiet thumb. -->
    <Style Selector="ScrollBar /template/ RepeatButton">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="10" />
        <Setter Property="Margin" Value="0,2,2,2" />
    </Style>
    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="2,0,2,2" />
    </Style>
    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource SemiColorFill2}" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>
    <!-- Toasts: always fully opaque (pins out the stock fade) and no height collapse; the horizontal slide is set in App.Initialize. -->
    <Style Selector="NotificationCard">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Transitions" Value="{x:Null}" />
        <Style.Animations>
            <Animation Duration="0:0:1" IterationCount="INFINITE">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="NotificationCard /template/ LayoutTransformControl, NotificationCard /template/ ContentControl">
        <Setter Property="Transitions" Value="{x:Null}" />
    </Style>
    <!-- Group tabs (Semi radio-group list): the hover/selected block is drawn by the presenter, which ignores the item radius. -->
    <Style Selector="ListBox.segmented">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.segTrack">
        <Setter Property="Background" Value="{DynamicResource ForkTrack}" />
        <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="Border.segThumb">
        <Setter Property="Background" Value="{DynamicResource ForkThumb}" />
        <Setter Property="BoxShadow" Value="{DynamicResource ForkShadowSm}" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Transitions">
            <Transitions>
                <ThicknessTransition Easing="{StaticResource CdsSpringSnappy}" Property="Margin" Duration="0:0:0.32" />
                <DoubleTransition Easing="{StaticResource CdsSpringSnappy}" Property="Width" Duration="0:0:0.32" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="TextBlock.logLabel">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="1.2" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
    </Style>
    <Style Selector="ListBox.segmented.compact ListBoxItem">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:selected">
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.segmented ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Easing="{StaticResource CdsEaseSwift}" Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ToolTip">
        <Setter Property="CornerRadius" Value="{StaticResource ForkRadiusSm}" />
        <Setter Property="MaxWidth" Value="360" />
    </Style>
    <!-- A plain string tip is shown in an implicit TextBlock; wrap it so long hints stay inside MaxWidth. -->
    <Style Selector="ToolTip TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="ContextMenu">
        <Setter Property="CornerRadius" Value="{StaticResource ForkRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="ContextMenu /template/ Border">
        <Setter Property="BoxShadow" Value="{DynamicResource ForkShadowPopover}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="CornerRadius" Value="{StaticResource ForkRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />

    </Style>
    <Style Selector="MenuFlyoutPresenter /template/ Border">
        <Setter Property="BoxShadow" Value="{DynamicResource ForkShadowPopover}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- Switch knob: spring (see CDS spring presets). -->
    <Style Selector="ToggleSwitch">
        <Setter Property="KnobTransitions">
            <Transitions>
                <DoubleTransition Easing="{StaticResource CdsSpringBouncy}" Property="Canvas.Left" Duration="0:0:0.5" />
            </Transitions>
        </Setter>
    </Style>
    <!-- Focus: the clay triple ring. -->
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BoxShadow" Value="{DynamicResource ForkShadowFocus}" />
    </Style>
    <Style Selector="TextBox.pill:focus /template/ Border#PART_BorderElement">
        <Setter Property="BoxShadow" Value="{DynamicResource ForkShadowFocusPill}" />
    </Style>
    <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="{DynamicResource ForkShadowFocus}" />
    </Style>
    <!-- Popups fade in and rise 8 px (RenderTransform is not rendered by the popup host and keyframed RenderTransform crashes this build, so the template Border margin is animated). -->
    <Style Selector="ContextMenu /template/ Border, MenuFlyoutPresenter /template/ Border">
        <Style.Animations>
            <Animation Duration="0:0:0.2" Easing="{StaticResource CdsEaseEnter}" FillMode="Both">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="Margin" Value="0,8,0,0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Margin" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <!-- Submenus and drop-downs enter the same way every time they open (the :open / :dropdownopen state restarts it). -->
    <Style Selector="MenuItem:open /template/ Popup > Border">
        <Style.Animations>
            <Animation Duration="0:0:0.2" Easing="{StaticResource CdsEaseEnter}" FillMode="Both">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="Margin" Value="0,8,0,0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Margin" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <!-- Drop-downs fade only: a margin change would resize the popup, and the upward ones are anchored at their bottom. -->
    <Style Selector="ComboBox:dropdownopen /template/ Popup > Border">
        <Style.Animations>
            <Animation Duration="0:0:0.18" Easing="{StaticResource CdsEaseEnter}" FillMode="Both">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <!-- Title-bar caption buttons -->
    <Style Selector="Button.caption">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
        <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="Button.caption:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SemiColorFill2}" />
        <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="Button.caption /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#E81123" />
    </Style>
    <Style Selector="Button.caption.close:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#F1707A" />
    </Style>
    <Style Selector="Button.caption.close:pointerover, Button.caption.close:pressed">
        <Setter Property="Foreground" Value="White" />
    </Style>
    <!-- Status bar combos sit at the bottom edge: their list opens upward. -->
    <Style Selector="ComboBox.dropUp">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox.dropUp ComboBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox.dropUp /template/ Popup#PART_Popup">
        <Setter Property="Placement" Value="TopEdgeAlignedLeft" />
    </Style>
    <Style Selector="Expander">
        <Setter Property="CornerRadius" Value="{StaticResource ForkRadiusSm}" />
    </Style>
    <!--
        States (open-claude-ui empty / loading / error patterns). Use in any view:
          Border.emptyState > StackPanel { Border.emptyBadge > PathIcon, TextBlock.emptyTitle, TextBlock.emptyHint, StackPanel.emptyActions }
          Ellipse.pulseDot (clay breathing dot; add .dead for a still grey dot). Loading uses Semi's indeterminate ProgressBar.
        The empty state fades in and rises 12 px (animated on Padding, so a Margin set by the view is kept) each time it becomes visible.
    -->
    <Style Selector="Border.emptyState">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="MaxWidth" Value="380" />
    </Style>
    <Style Selector="Border.emptyState[IsVisible=True]">
        <Style.Animations>
            <Animation Duration="0:0:0.42" Easing="{StaticResource CdsEaseEnter}" FillMode="Both">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="Padding" Value="24,36,24,12" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Padding" Value="24" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Border.emptyState > StackPanel">
        <Setter Property="Spacing" Value="6" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.emptyBadge">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="{StaticResource ForkRadius}" />
        <Setter Property="Background" Value="{DynamicResource ForkClayLight}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Border.emptyBadge > PathIcon">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Foreground" Value="{DynamicResource ForkClay}" />
    </Style>
    <Style Selector="TextBlock.emptyTitle">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.emptyHint">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="18" />
    </Style>
    <Style Selector="StackPanel.emptyActions">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,12,0,0" />
    </Style>
    <Style Selector="Ellipse.pulseDot">
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Fill" Value="{DynamicResource ForkClay}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Ellipse.pulseDot.dead">
        <Setter Property="Fill" Value="{DynamicResource SemiColorText3}" />
    </Style>
    <Style Selector="Ellipse.pulseDot:not(.dead)">
        <Style.Animations>
            <Animation Duration="0:0:1.9" Easing="{StaticResource CdsEasePulse}" IterationCount="INFINITE" PlaybackDirection="Alternate">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0.3" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <!-- Numbers that change in place (latency, speed, traffic) use tabular digits so columns never jitter. -->
    <Style Selector="TextBlock.num, DataGridCell TextBlock">
        <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
</Styles>
