<UserControl
    x:Class="v2rayN.Desktop.Views.StatusBarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    x:DataType="vms:StatusBarViewModel"
    Design.DataContext="{x:Static dd:DesignData.StatusBar}"
    mc:Ignorable="d">
    <Border
        Padding="16,10"
        BorderBrush="{DynamicResource SemiColorBorder}"
        BorderThickness="0,1,0,0">
        <Grid x:Name="gridStatus" ColumnDefinitions="*,Auto,Auto,236">
            <!-- Running node: name on top, delay below. -->
            <StackPanel
                x:Name="pnlNode"
                Grid.Column="0"
                MinWidth="90"
                ClipToBounds="True"
                Margin="0,0,8,0"
                VerticalAlignment="Center">
                <!-- fork: a clay dot breathes beside the running node (open-claude-ui quiet pulse, 1.9 s) -->
                <DockPanel>
                    <Ellipse
                        x:Name="dotRunning"
                        Margin="0,0,7,0"
                        Classes="pulseDot"
                        DockPanel.Dock="Left"
                        IsVisible="{Binding #txtRunningServerDisplay.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock
                        x:Name="txtRunningServerDisplay"
                        FontWeight="Medium"
                        TextTrimming="CharacterEllipsis"
                        ToolTip.Tip="{Binding $self.Text}" />
                </DockPanel>
                <TextBlock
                    x:Name="txtRunningInfoDisplay"
                    Margin="13,2,0,0"
                    Classes="secondary"
                    TextTrimming="CharacterEllipsis"
                    ToolTip.Tip="{Binding $self.Text}" />
            </StackPanel>

            <!-- Where the proxy listens. -->
            <StackPanel
                x:Name="pnlInbound"
                Grid.Column="1"
                Margin="0,0,12,0"
                VerticalAlignment="Center">
                <TextBlock x:Name="txtInboundDisplay" Classes="secondary" />
                <TextBlock
                    x:Name="txtInboundLanDisplay"
                    Margin="0,2,0,0"
                    Classes="secondary" />
            </StackPanel>

            <!-- Quick controls. -->
            <StackPanel
                Grid.Column="2"
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <StackPanel
                    x:Name="spEnableTun"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock VerticalAlignment="Center" Text="{x:Static resx:ResUI.TbEnableTunAs}" />
                    <ToggleSwitch
                        x:Name="togEnableTun"
                        VerticalAlignment="Center"
                        Theme="{DynamicResource SimpleToggleSwitch}" />
                </StackPanel>
                <ComboBox
                    x:Name="cmbSystemProxy"
                    MinWidth="150"
                    Classes="pill dropUp"
                    VerticalAlignment="Center"
                    ToolTip.Tip="{x:Static resx:ResUI.menuSystemproxy}">
                    <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxyClear}" />
                    <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxySet}" />
                    <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxyNothing}" />
                    <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxyPac}" />
                </ComboBox>
                <ComboBox
                    x:Name="cmbRoutings2"
                    Classes="pill dropUp"
                    MinWidth="110"
                    VerticalAlignment="Center"
                    DisplayMemberBinding="{Binding Remarks}"
                    ItemsSource="{Binding RoutingItems}"
                    ToolTip.Tip="{x:Static resx:ResUI.menuRouting}" />
            </StackPanel>

            <!-- Throughput: fixed 270 px column (fits the longest "direct : 1023.9 MB/s up | 1023.9 MB/s down"), monospaced so digits do not jitter; the other columns never move. -->
            <StackPanel
                x:Name="pnlSpeed"
                Grid.Column="3"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="txtSpeedProxyDisplay"
                    HorizontalAlignment="Right"
                    FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                    FontSize="11"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="txtSpeedDirectDisplay"
                    Margin="0,2,0,0"
                    HorizontalAlignment="Right"
                    FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                    FontSize="11"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{DynamicResource SemiColorText2}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
