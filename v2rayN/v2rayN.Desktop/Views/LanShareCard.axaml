<UserControl
    x:Class="v2rayN.Desktop.Views.LanShareCard"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:v2rayN.Desktop.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Styles>
        <Style Selector="TextBlock.lanStatusOk">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorSuccess}" />
        </Style>
        <Style Selector="TextBlock.lanStatusWarn">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorWarning}" />
        </Style>
        <Style Selector="TextBlock.lanStatusDanger">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorDanger}" />
        </Style>
        <Style Selector="TextBlock.lanStatusMuted">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
        </Style>
    </UserControl.Styles>
    <Border Classes="settingsGroup">
        <StackPanel>
            <TextBlock Classes="settingsGroupTitle" Text="{x:Static common:ForkText.LanShareTitle}" />

            <!-- Status and the one-click recommended setup share a row. -->
            <Grid Margin="0,2" ColumnDefinitions="*,Auto" MinHeight="40">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        x:Name="txtLanShareStatus"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Border Classes="infoDot" ToolTip.Tip="{x:Static common:ForkText.LanShareApplyTip}">
                        <TextBlock Text="i" />
                    </Border>
                    <Button x:Name="btnApplyLanRecommended" Content="{x:Static common:ForkText.LanShareApplyRecommended}" />
                </StackPanel>
            </Grid>
            <TextBlock
                x:Name="txtLanShareStatusTip"
                Margin="0,0,0,4"
                Classes="secondary"
                IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="txtLanShareApplied"
                Margin="0,0,0,4"
                Classes="secondary lanStatusOk"
                IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                TextWrapping="Wrap" />

            <Border Classes="divider" Margin="0,6" />

            <TextBlock
                x:Name="txtLanAddressHint"
                Margin="0,4"
                Classes="secondary" />

            <StackPanel x:Name="pnlLanAddress">
                <Grid Margin="0,4" ColumnDefinitions="90,*,Auto" MinHeight="36">
                    <TextBlock VerticalAlignment="Center" Text="{x:Static common:ForkText.LanShareInterface}" />
                    <ComboBox
                        x:Name="cmbLanIp"
                        Grid.Column="1"
                        MinWidth="240"
                        HorizontalAlignment="Left" />
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">
                        <TextBlock Classes="secondary" Text="{x:Static common:ForkText.LanShareLanPort}" />
                        <TextBlock x:Name="txtLanPort" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,4" ColumnDefinitions="90,*,Auto" MinHeight="36">
                    <TextBlock VerticalAlignment="Center" Text="HTTP" />
                    <TextBox
                        x:Name="txtLanHttpProxy"
                        Grid.Column="1"
                        IsReadOnly="True" />
                    <Button
                        x:Name="btnCopyLanHttp"
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        Content="{x:Static common:ForkText.LanShareCopy}" />
                </Grid>
                <Grid Margin="0,4" ColumnDefinitions="90,*,Auto" MinHeight="36">
                    <TextBlock VerticalAlignment="Center" Text="SOCKS5" />
                    <TextBox
                        x:Name="txtLanSocksProxy"
                        Grid.Column="1"
                        IsReadOnly="True" />
                    <Button
                        x:Name="btnCopyLanSocks"
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        Content="{x:Static common:ForkText.LanShareCopy}" />
                </Grid>
                <Button
                    x:Name="btnToggleLanPassword"
                    Margin="90,2,0,0"
                    HorizontalAlignment="Left"
                    Classes="IconButton"
                    Padding="10,0"
                    Content="{x:Static common:ForkText.LanShareShowPassword}" />
            </StackPanel>

            <StackPanel x:Name="pnlFirewall">
                <Border Classes="divider" Margin="0,6" />
                <Grid Margin="0,2" ColumnDefinitions="Auto,Auto,Auto,*" MinHeight="40">
                    <TextBlock
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Text="{x:Static common:ForkText.LanFirewallTitle}" />
                    <Button
                        x:Name="btnAddFirewallRule"
                        Grid.Column="1"
                        IsEnabled="False"
                        Content="{x:Static common:ForkText.LanFirewallButton}" />
                    <Border
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        Classes="infoDot"
                        ToolTip.Tip="{x:Static common:ForkText.LanFirewallTip}">
                        <TextBlock Text="i" />
                    </Border>
                </Grid>
                <TextBlock
                    x:Name="txtFirewallResult"
                    Classes="secondary"
                    IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
